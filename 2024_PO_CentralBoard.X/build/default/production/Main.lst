0025C:  BCF    F88.0
0025E:  BCF    F83.0
....................             output_high(MULTIPLEXER_SELECT_PIN_2);
00260:  BCF    F88.1
00262:  BSF    F83.1
....................             break;
00264:  BRA    026E
....................             
....................         case 3:                                                                 // Accélérateur //
